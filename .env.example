# Copy to .env and change the secrets before putting this on a network.
SECRET_KEY=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

COLLEGE_NAME=St. Xavier's College (Autonomous), Ahmedabad

# Models
LLM_PATH=./models/Qwen2.5-3B-Instruct
LLM_DEVICE=auto
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DEVICE=cpu
MAX_NEW_TOKENS=512

# Retrieval - PDF + website searched as separate pools, merged, reranked, top TOP_K to the LLM
CHUNK_SIZE=1600
CHUNK_OVERLAP=300
PER_SOURCE_CANDIDATES=20
TOP_K=5
RERANK_MODEL=BAAI/bge-reranker-base
# RERANK_DEVICE auto-detects cuda/cpu if left unset. RERANK_BATCH_SIZE=8 keeps
# peak VRAM well under a small GPU's budget alongside the LLM - see README
# "Performance" section for the measurements behind these two settings.
RERANK_DEVICE=
RERANK_BATCH_SIZE=8
RERANK_FLOOR=0.02
RERANK_RELATIVE_MARGIN=0.5

# Database - users, document registry, chat history and crawl logs (see
# backend/db/). Create the role/database once as a Postgres superuser:
#   CREATE ROLE admission_bot WITH LOGIN PASSWORD '<pick a password>';
#   CREATE DATABASE admission_chatbot OWNER admission_bot;
# then `python -m backend.db.init_db` to apply the schema.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=admission_chatbot
DB_USER=admission_bot
DB_PASSWORD=your_database_password_here
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/admission_chatbot

# Gemini Multilingual Intent Extraction (Optional fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Crawler Settings
LIVE_CRAWL_FALLBACK_ENABLED=false
